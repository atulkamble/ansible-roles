digraph AnsibleRoleFlow {
  graph [rankdir=TB, bgcolor="#F6F8FC", pad="0.28", nodesep="0.32", ranksep="0.42", splines=ortho, fontname="Arial", label="ANSIBLE ROLES · BASIC PRACTICE", labelloc=t, fontsize=22, fontcolor="#14213D"];
  node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, margin="0.18,0.11", color="#D5DFEC", penwidth=1.2, fillcolor="white", fontcolor="#172B4D"];
  edge [fontname="Arial", fontsize=9, color="#7185A5", penwidth=1.5, arrowsize=0.75, fontcolor="#526782"];

  start [label="START · Ansible control node\n/etc/ansible", fillcolor="#E5F0FF", color="#8CB7F5", penwidth=1.6];
  config [label="Read configuration\nansible.cfg → inventory/hosts\nSSH as ec2-user · sudo enabled", fillcolor="#FFFFFF"];
  verify [label="Check access\nchmod 400 aws/ansible.pem\nansible-inventory --graph\nansible web -m ping", fillcolor="#FFFFFF"];
  target [label="Target scope: [web]\n23.22.227.133\n[db] 32.202.123.57 is not targeted", fillcolor="#FFF5DB", color="#E8C66E"];
  role [label="Load reusable role: webserver\nroles/webserver/", fillcolor="#EAF7EF", color="#8BC9A0", penwidth=1.6];

  defaults [label="defaults/main.yml\nPackage/service: httpd\nDocument root + page text", fillcolor="#FFFFFF"];
  install [label="TASK 1 · Install Apache\nDNF ensures httpd is present", fillcolor="#FFFFFF"];
  template [label="TASK 2 · Render homepage\nJinja2 variables + inventory_hostname\nWrite /var/www/html/index.html", fillcolor="#FFFFFF"];
  changed [shape=diamond, label="Template\nchanged?", style="filled", fillcolor="#F0EBFF", color="#B4A0E8", width=1.2, height=0.75, margin="0.08"];
  handler [label="HANDLER · Restart Apache\nRuns only when notified by template task", fillcolor="#FCECEF", color="#E8A5B1"];
  service [label="TASK 3 · Ensure service state\nhttpd started and enabled", fillcolor="#FFFFFF"];
  done [label="APPLY · Apache ready on web host", fillcolor="#E5F0FF", color="#8CB7F5", penwidth=1.6];
  verifyweb [label="VERIFY\nAnsible: systemctl is-active httpd\nAnsible: curl -s http://localhost\nFrom control node: curl http://23.22.227.133", fillcolor="#FFFFFF"];
  repeat [shape=diamond, label="Run again", style="filled", fillcolor="#F0EBFF", color="#B4A0E8", width=1.25, height=0.72, margin="0.08"];
  idem [label="Mostly OK · no unnecessary changes\nIdempotent desired state", fillcolor="#EAF7EF", color="#8BC9A0"];
  end [label="END · Practice overrides, add a web host,\nor compare hosts: web with hosts: all", fillcolor="#E5F0FF", color="#8CB7F5"];

  start -> config -> verify -> target -> role;
  role -> defaults;
  defaults -> install -> template -> changed;
  changed -> handler [label="Yes"];
  changed -> service [label="No"];
  handler -> service;
  service -> done -> verifyweb -> repeat;
  repeat -> idem [label="Second run"];
  repeat -> end [label="Continue"];
  idem -> end;
}
